    "@remotion/renderer": "4.0.536",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "playwright-core": "1.55.0",
    "typescript": "5.8.3"
  }
}
